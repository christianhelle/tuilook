"┏ Calen┌Keys──────────────────────────────────────────────────────────────────────┐━━━━━━┓"
"┃Mon 2 │a  w  m                  Show the agenda, the week or the month           │      ┃"
"┃  All │↑ ↓  j k                 Next appointment; in the month, the week         │      ┃"
"┃  09:0│← →  h l                 Week and month: the day before or after          │      ┃"
"┃Tue 3 │n p                      Week and month: the day's next or previous       │      ┃"
"┃  14:0│PgUp PgDn                Week and month: the one before or after          │      ┃"
"┃      │g Home  G End  t         Jump to the first, the last, or today            │      ┃"
"┃      │Enter                    Show the appointment in full, or hide it         │      ┃"
"┃      │c                        Write a new appointment                          │      ┃"
"┃      │e                        Change the appointment                           │      ┃"
"┃      │d                        Delete it, and cancel it for anyone invited      │      ┃"
"┃      │F5                       Sync the calendar now                            │      ┃"
"┃      │Tab / Shift-Tab          Show the next account's calendar / previous      │      ┃"
"┃      │Esc  q                   Back to the mail                                 │      ┃"
"┗━━━━━━│Ctrl-C                   Quit                                             │━━━━━━┛"
